# Copy to .env (never commit .env). All values optional unless noted.

# cloud (default) | lan
MODE=cloud
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# --- Transport security (one of these is REQUIRED, otherwise the server refuses to start) ---
# a) Terminate TLS in the server:
#TLS_CERT_FILE=/run/secrets/fullchain.pem
#TLS_KEY_FILE=/run/secrets/privkey.pem
# b) TLS terminated by a reverse proxy (Caddy). Last N X-Forwarded-For hops are trusted.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
# c) Cleartext ws:// — LAN only, explicit opt-in.
ALLOW_INSECURE_WS=false

# Public URL used to build the QR payload, e.g. wss://cast.example.com/ws
#PUBLIC_URL=
# Browser Origins allowed to open a socket (native apps send none). Default: none.
ALLOWED_ORIGINS=

# --- Pairing ---
PAIRING_TTL_SECONDS=300
APPROVAL_TIMEOUT_SECONDS=60
JOIN_MAX_FAILURES=5
JOIN_FAILURE_WINDOW_SECONDS=60
JOIN_BLOCK_SECONDS=300
CREATE_MAX_PER_MINUTE=10
# HMAC key for stored code hashes. Random per process when empty (fine for in-memory store).
#PAIRING_SECRET=

# --- ICE / TURN (coturn use-auth-secret) ---
STUN_URLS=
TURN_URLS=
# Must equal coturn static-auth-secret. Generate: openssl rand -hex 32
TURN_SECRET=
TURN_TTL_SECONDS=21600

# --- LAN discovery ---
# Defaults to true when MODE=lan
#MDNS_ENABLED=true
MDNS_NAME=Mirror Signaling
